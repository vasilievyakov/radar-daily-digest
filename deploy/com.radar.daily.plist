<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily run at 08:00 local time.

  StartCalendarInterval, not cron: cron does not fire on a sleeping laptop and
  silently skips the day, which is the one failure this product cannot afford
  — a silent agent looks exactly like a quiet day. launchd runs the job on
  wake instead.

  Install:  cp deploy/com.radar.daily.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.radar.daily.plist
  Remove:   launchctl unload ~/Library/LaunchAgents/com.radar.daily.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.radar.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Demo Challenge" &amp;&amp; .venv/bin/python -m radar.cli run --deliver</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/radar-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/radar-daily.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
